{
  "name": "<%= importPath %>",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",<% if (buildable) { %>
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",<% } else { %>
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  <% } %>"dependencies": {},
  "exports": {<% if (buildable) { %>
    "./package.json": "./package.json",
    ".": {
      "<%= customCondition %>": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  <% } else { %>
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  <% } %>},
  "devDependencies": {
    "@types/react": "*",
    "react-native": "*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  }
}
