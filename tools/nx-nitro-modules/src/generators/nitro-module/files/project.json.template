{
  "name": "<%= projectName %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "<%= projectRoot %>/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "<%= projectRoot %>",
        "command": "pnpm nitrogen"
      }
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "<%= projectRoot %>",
        "command": "rm -rf nitrogen dist"
      }
    }
  }
}
