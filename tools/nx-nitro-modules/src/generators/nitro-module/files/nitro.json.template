{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["<%= cxxName %>"],
  "ios": {
    "iosModuleName": "<%= className %>"
  },
  "android": {
    "androidNamespace": <%- androidNamespaceJson %>,
    "androidCxxLibName": "<%= className %>"
  },
  "autolinking": {
    "<%= className %>": {
      "ios": {
        "language": "swift",
        "implementationClassName": "<%= className %>"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "<%= className %>"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "dist"]
}
