{
  "name": "@wuguishifu/nx-aws-cdk",
  "version": "0.0.1",
  "description": "Nx plugin that scaffolds AWS CDK apps and stacks inside an Nx workspace.",
  "keywords": [
    "nx",
    "nx-plugin",
    "aws",
    "aws-cdk",
    "cdk",
    "lambda",
    "infrastructure-as-code",
    "generator",
    "monorepo"
  ],
  "license": "MIT",
  "author": "Bo Bramer <bramer.bo@gmail.com>",
  "homepage": "https://github.com/wuguishifu/generators/tree/main/tools/nx-aws-cdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuguishifu/generators.git",
    "directory": "tools/nx-aws-cdk"
  },
  "bugs": {
    "url": "https://github.com/wuguishifu/generators/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "generators": "./generators.json",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nx/devkit": "^23.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@root/utils": "workspace:*"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json"
  ]
}
