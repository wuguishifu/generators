import * as cdk from 'aws-cdk-lib';
import type { Construct } from 'constructs';
import * as path from 'path';

import type { StageConfig } from '../../config';
import { NodeFunction } from '../../constructs/node-function';

export interface <%= className %>StackProps extends cdk.StackProps {
  readonly config: StageConfig;
}

export class <%= className %>Stack extends cdk.Stack {
  constructor(scope: Construct, id: string, props: <%= className %>StackProps) {
    super(scope, id, props);

    const helloFunction = new NodeFunction(this, 'HelloFunction', {
      config: props.config,
      entry: path.join(__dirname, 'handlers.ts'),
      handler: 'hello',
    });

    new cdk.CfnOutput(this, 'HelloFunctionName', {
      value: helloFunction.functionName,
    });
  }
}
