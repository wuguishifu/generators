import * as cdk from 'aws-cdk-lib';
import type { Construct } from 'constructs';

import type { StageConfig } from './config';

export interface AppStageProps extends cdk.StageProps {
  readonly config: StageConfig;
}

/**
 * One deployable copy of the app. Add stacks to the constructor, or run
 * `nx g @wuguishifu/nx-aws-cdk:stack <name> --project=<%= projectName %>`.
 *
 * Pass resources between stacks as props (for example, a table from a data
 * stack into a stack whose functions use it). Keep resources that refer to
 * each other, such as an API's routes and its integrations, in the same stack:
 * splitting them creates CloudFormation exports that block later changes.
 */
export class AppStage extends cdk.Stage {
  constructor(scope: Construct, id: string, props: AppStageProps) {
    super(scope, id, props);

    cdk.Tags.of(this).add('app', '<%= projectName %>');
    cdk.Tags.of(this).add('stage', props.config.name);
  }
}
