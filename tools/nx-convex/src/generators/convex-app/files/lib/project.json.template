{
  "name": "<%= libName %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "<%= libName %>/src",
  "projectType": "library",
  "// targets": "to see all targets run: nx show project <%= libName %> --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["<%= appName %>"], "target": "typecheck" }],
      "options": {
        "cwd": "<%= libDirectory %>",
        "command": "node ./scripts/build.mjs"
      }
    },
    "typecheck": {
      "dependsOn": ["build"]
    }
  }
}
