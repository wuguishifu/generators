Pod::Spec.new do |s|
  s.name           = '<%= className %>'
  s.version        = '0.0.1'
  s.summary        = '<%= description %>'
  s.description    = '<%= description %>'
  s.author         = '<%= author %>'
  s.homepage       = '<%= homepage %>'
  s.platforms      = {
    :ios => '16.4',
    :tvos => '16.4'
  }
  s.source         = { git: '' }
  s.static_framework = true

  s.dependency 'ExpoModulesCore'

  # Swift/Objective-C compatibility
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
  }

  s.source_files = "**/*.{h,m,mm,swift,hpp,cpp}"
end
